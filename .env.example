# ─── مصدر المحتوى ──────────────────────────────────────────────
# wordpress (افتراضي): يقرأ المقالات والشعار والصور من موقع WordPress الأصلي.
# fixtures: بيانات معاينة محلية للتطوير والاختبار فقط (تظهر معها لافتة "وضع المعاينة").
CONTENT_SOURCE=wordpress
WP_API_URL=https://risalatalkalima.com/wp-json
NEXT_PUBLIC_SITE_URL=https://risalatalkalima.com
# مدة التخزين المؤقت لاستجابات WordPress بالثواني
WP_REVALIDATE_SECONDS=600
# سرّ لإعادة توليد الصفحات فور نشر مقال: POST /api/revalidate?secret=...
REVALIDATE_SECRET=

# ─── الشعار ───────────────────────────────────────────────────
# يُجلب الشعار تلقائيًا من إعدادات WordPress (site_logo). لفرض ملف محدّد:
NEXT_PUBLIC_LOGO_URL=

# ─── صفحات ثابتة في WordPress ─────────────────────────────────
ABOUT_PAGE_SLUG=من-نحن
CONTACT_PAGE_SLUG=اتصل-بنا

# ─── روابط التواصل (تظهر فقط الروابط المعبّأة) ─────────────────
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_WHATSAPP=
# بيانات تواصل رسمية (تظهر في صفحة الاتصال إن وُجدت)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# ─── النشرة البريدية ──────────────────────────────────────────
# mailchimp | brevo | webhook — اتركه فارغًا لتعطيل الاشتراك (سيظهر خطأ صريح لا نجاح وهمي)
NEWSLETTER_PROVIDER=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
BREVO_API_KEY=
BREVO_LIST_ID=
NEWSLETTER_WEBHOOK_URL=

# ─── نموذج الاتصال ────────────────────────────────────────────
# cf7 (Contact Form 7 على موقع WordPress) | webhook — فارغ = معطّل
CONTACT_PROVIDER=
CF7_FORM_ID=
CONTACT_WEBHOOK_URL=
