# Copy to .env.local and fill in. Never commit real secrets.
# Empty values are treated as "not set".

# ── Content ───────────────────────────────────────────────────────────────
# WordPress REST API root (the existing site, or the CMS subdomain after launch).
WP_API_URL=https://risalatalkalima.com/wp-json
# How long (seconds) WordPress responses are cached before a background refresh.
WP_REVALIDATE_SECONDS=600
# Pages of recent articles (100 per page) loaded into the Arabic-aware search index (default 6 = latest 600).
SEARCH_INDEX_PAGES=6
# 'fixtures' = labelled preview data (no WordPress needed, noindex). Leave empty in production.
CONTENT_SOURCE=

# ── Site ──────────────────────────────────────────────────────────────────
# Public origin, no trailing slash (canonical URLs, sitemap, RSS, Open Graph).
NEXT_PUBLIC_SITE_URL=https://risalatalkalima.com
# Optional: URL of the ORIGINAL logo file. If empty, the logo set in WordPress
# (Appearance → Customise → Site Identity) is used. Never a redrawn logo.
NEXT_PUBLIC_LOGO_URL=
# WordPress page slugs whose content feeds /about/ and /contact/ (defaults shown).
ABOUT_PAGE_SLUG=من-نحن
CONTACT_PAGE_SLUG=اتصل-بنا

# ── Official social links (only the ones set are shown) ───────────────────
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
# e.g. https://wa.me/9611234567
NEXT_PUBLIC_SOCIAL_WHATSAPP=

# ── Official contact details (only the ones set are shown on /contact/) ───
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# ── On-demand revalidation (/api/revalidate) ──────────────────────────────
# Long random string; WordPress sends it in the `x-revalidate-secret` header
# (or `Authorization: Bearer …`). Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# ── Contact form (/api/contact) ───────────────────────────────────────────
# 'cf7' (Contact Form 7 on the WordPress site) or 'webhook'. Empty = form disabled (503).
CONTACT_PROVIDER=
# Contact Form 7 form id (the number in [contact-form-7 id="…"]); uses WP_API_URL.
# The form must have the fields your-name, your-email, your-subject, your-message.
CF7_FORM_ID=
# For CONTACT_PROVIDER=webhook: receives JSON {name, email, subject, message, site, submittedAt}.
CONTACT_WEBHOOK_URL=

# ── Newsletter (/api/newsletter) ──────────────────────────────────────────
# 'mailchimp', 'brevo', 'mailpoet' or 'webhook'. Empty = sign-up disabled (503).
NEWSLETTER_PROVIDER=
# Mailchimp: API key including its data-centre suffix (…-us21) and the audience id. Double opt-in.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
# Brevo: API key and numeric list id.
BREVO_API_KEY=
BREVO_LIST_ID=
# For 'mailpoet' or 'webhook': receives JSON {email, site, subscribedAt}; 2xx = subscribed.
NEWSLETTER_WEBHOOK_URL=

# ── Rate limiting (contact, newsletter, search) ───────────────────────────
# Set to 1 only when a reverse proxy in front of the app overwrites x-real-ip / x-forwarded-for
# (nginx, Cloudflare…), so clients cannot spoof them. Not needed on Vercel (detected automatically).
# Otherwise only the last x-forwarded-for hop is used to tell clients apart.
TRUST_PROXY=

# ── Tests ─────────────────────────────────────────────────────────────────
# Optional: path to a Chromium binary for Playwright (npm run test:e2e),
# e.g. /opt/pw-browsers/chromium-1194/chrome-linux/chrome
PW_CHROMIUM_PATH=
